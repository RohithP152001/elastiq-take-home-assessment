import pytest
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.chrome.options import Options

class TestTableSearchDemo:
    @pytest.fixture(scope="class")
    def setup(self):
        chrome_options = Options()
        chrome_options.add_argument("--disable-gpu")
        driver = webdriver.Chrome(options=chrome_options)
        yield driver
        driver.quit()

    def test_table_search(self, setup):
        driver = setup
        url = "https://www.lambdatest.com/selenium-playground/table-sort-search-demo"
        driver.get(url)

        # Find the search input field and enter 'New York'
        search_box = driver.find_element(By.XPATH, "//*[@id='example_filter']/label/input")
        search_box.send_keys("New York")

        # Get all rows in the table and filter visible rows
        table_rows = driver.find_elements(By.XPATH, "//*[@id='example']/tbody/tr")
        visible_rows = [row for row in table_rows if row.is_displayed()]
        visible_row_count = len(visible_rows)
        assert visible_row_count == 5, f"Expected 5 visible rows, but found {visible_row_count}."

        # Validate total rows in the table
        total_rows_count = len(table_rows)
        assert total_rows_count == 24, f"Expected 24 total rows, but found {total_rows_count}."

if __name__ == "__main__":
    pytest.main(["-v", __file__])

Approach :

1. The script navigates to the Selenium Playground Table Search Demo.
2. It locates the search box using the By.ID locator strategy.
3. It enters the text "New York" in the search box.
4. The script fetches all rows in the table and filters out those that are not visible.
5. Assertions verify the number of visible rows is 5 and optionally confirm the total entries count.

How to Run the Script :

1. Prerequisites:
    Python 3.7 or later installed.
    Latest version of Chrome browser installed.

2. Setup:
    Install dependencies: pip install selenium webdriver-manager pytest

3. Run the Test:
    Save the script as qa_selenium_test.py.
    Run the test using pytest: pytest qa_selenium_test.py

Additional Notes:
1. The script uses the webdriver-manager package to handle ChromeDriver setup automatically.
2. Ensure an active internet connection for downloading the driver via webdriver-manager.
3. For testing with other browsers (e.g., Firefox), update the driver initialization logic in setup_browser.
